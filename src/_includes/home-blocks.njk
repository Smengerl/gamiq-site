{%- macro pnl(n, alt) %}<div class="bub"><img class="pnl" src="../assets/panels/{{ n }}.png" alt="{{ alt }}" width="64" height="64" loading="lazy"></div>{% endmacro -%}
{%- macro phone(n, alt) %}<div class="phc"><img src="../assets/phone/{{ n }}.png" alt="{{ alt }}" width="585" height="900" style="aspect-ratio:585/900;object-fit:cover;object-position:top" loading="lazy"></div>{% endmacro -%}
<header class="hero">{% include "court.njk" %}<div class="wrap">
 <div><div class="eyebrow">{{ t.hero.eyebrow }}</div>
 <h1>{{ t.hero.h1 }}</h1>
 <p class="lead">{{ t.hero.lead }}</p>
 <div class="cta"><a class="btn p" href="#kontakt">{{ t.hero.cta1 }}</a><a class="btn s" href="#spieltag">{{ t.hero.cta2 }}</a></div>
 <small>{{ t.hero.note }}</small></div>
 <div><div class="set">
  <div>{{ pnl("shot_run", t.hero.cap_shot) }}<div class="cap">{{ t.hero.cap_shot }}</div></div>
  <div>{{ pnl("clock_run", t.hero.cap_clock) }}<div class="cap">{{ t.hero.cap_clock }}</div></div>
  <div>{{ pnl("score", t.hero.cap_score) }}<div class="cap">{{ t.hero.cap_score }}</div></div>
 </div>
 <div class="also"><span class="alsolbl">{{ t.hero.same }}</span><div class="chiprow">{% for c in t.hero.chips %}<span class="chip a">{{ c }}</span>{% endfor %}<span class="chip">{{ t.hero.planned }}</span></div></div></div>
</div></header>

<section id="spieltag"><div class="wrap">
 <div class="eyebrow">{{ t.steps.eyebrow }}</div><h2>{{ t.steps.title }}</h2><p class="sub">{{ t.steps.sub }}</p>
 <ol class="steps">{% for i in t.steps.items %}<li><b>{{ i.t }}</b><span>{{ i.d }}</span></li>{% endfor %}</ol></div></section>

<section class="alt"><div class="wrap">
 <div class="eyebrow">{{ t.core.eyebrow }}</div><h2>{{ t.core.title }}</h2>{% if t.core.sub %}<p class="sub">{{ t.core.sub }}</p>{% endif %}
 <div class="grid">{% for i in t.core.items %}<div class="card"><div class="ic">{{ loop.index }}</div><b>{{ i.t }}</b><p>{{ i.d }}</p></div>{% endfor %}</div></div></section>

<section id="spielarten"><div class="wrap">
 <div class="eyebrow">{{ t.types.eyebrow }}</div><h2>{{ t.types.title }}</h2><p class="sub">{{ t.types.sub }}</p>
 <div class="gt">
  {%- set pairs = [["shot_run","clock_run"],["cc1","cc3"],["tb_timer","tb_digits"]] %}
  {% for i in t.types.items %}<div class="card"><b>{{ i.t }}</b><div class="pair">{{ pnl(pairs[loop.index0][0], "") }}{{ pnl(pairs[loop.index0][1], "") }}</div><p>{{ i.d }}</p></div>{% endfor %}
  <div class="card soon"><b>{{ t.types.soon_t }}</b><p>{{ t.types.soon_d }}</p><div class="chips">{% for c in t.types.soon_chips %}<span class="chip">{{ c }}</span>{% endfor %}</div><p style="margin-top:auto">{{ t.types.soon_ask }} <a href="#kontakt">{{ t.types.soon_link }}</a></p></div>
 </div></div></section>

<section id="ausbau" class="alt"><div class="wrap">
 <div class="eyebrow">{{ t.build.eyebrow }}</div><h2>{{ t.build.title }}</h2><p class="sub">{{ t.build.sub }}</p>
 {% for c in t.build.configs %}{% set u = c.units | length %}{% set n = u + 2 %}<div class="max cfg"><div class="ch"><h3>{{ c.name }}</h3><span class="claim">{{ c.claim }}</span></div><p>{{ c.d }}</p>
  <div class="flat" style="--u:{{ u }}"><div class="row">{% for u in c.units %}<figure>{{ pnl(u.p, "") }}<figcaption><b>{{ u.t }}</b></figcaption></figure>{% endfor %}<figure class="tab"><div class="phc tabc"><img src="../assets/phone/tablet_{{ c.name | lower }}.png" alt="{{ c.tablet }}" width="615" height="{{ 360 if c.name == 'Midi' else 265 }}" loading="lazy"></div><figcaption><b>{{ c.tablet }}</b></figcaption></figure></div>
  <div class="fnet"><svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">{% for k in range(0, u) %}<line x1="{{ (k + 0.5) * 100 / n }}" y1="0" x2="{{ (k + 0.5) * 100 / n }}" y2="20"/>{% endfor %}<line x1="{{ (u + 1) * 100 / n }}" y1="0" x2="{{ (u + 1) * 100 / n }}" y2="20"/><line x1="{{ 50 / n }}" y1="20" x2="{{ (u + 1) * 100 / n }}" y2="20"/></svg>
  <div class="wifi"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" aria-hidden="true"><path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.5a9.5 9.5 0 0 1 13 0"/><path d="M8.7 16a5 5 0 0 1 6.6 0"/><circle cx="12" cy="19.5" r="1" fill="#ff9a1a"/></svg></div></div></div></div>{% endfor %}
 <div class="max">
  <div class="ch"><h3>{{ t.build.maxi.name }}</h3><span class="claim">{{ t.build.maxi.claim }}</span></div>
  {%- set ps = ["shot_run","home","clock_run","guest","shot_run"] %}
  <div class="p5">{% for u in t.build.units %}<figure>{{ pnl(ps[loop.index0], "") }}<figcaption><b>{{ u.t }}</b>{{ u.d }}</figcaption></figure>{% endfor %}</div>
  <div class="net"><svg viewBox="0 0 100 150" preserveAspectRatio="none" aria-hidden="true">
   <line x1="9.3" y1="0" x2="9.3" y2="24"/><line x1="29.65" y1="0" x2="29.65" y2="24"/><line x1="50" y1="0" x2="50" y2="24"/><line x1="70.35" y1="0" x2="70.35" y2="24"/><line x1="90.7" y1="0" x2="90.7" y2="24"/>
   <line x1="9.3" y1="24" x2="90.7" y2="24"/><line x1="50" y1="24" x2="50" y2="52"/><line x1="50" y1="116" x2="50" y2="150"/><path d="M50 116 L30 150"/><path d="M50 116 L70 150"/></svg>
   <div class="wifi"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" aria-hidden="true"><path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.5a9.5 9.5 0 0 1 13 0"/><path d="M8.7 16a5 5 0 0 1 6.6 0"/><circle cx="12" cy="19.5" r="1" fill="#ff9a1a"/></svg></div><div class="wl">{{ t.build.wifi }}</div></div>
  {%- set ph = ["shot","game","score"] %}
  <div class="p5"><div></div>{% for o in t.build.officials %}<figure>{{ phone(ph[loop.index0], "") }}<figcaption><b>{{ o }}</b></figcaption></figure>{% endfor %}<div></div></div>
  <p class="foot">{{ t.build.foot }}</p>
 </div></div></section>

<section id="rollen"><div class="wrap">
 <div class="eyebrow">{{ t.roles.eyebrow }}</div><h2>{{ t.roles.title }}</h2><p class="sub">{{ t.roles.sub }}</p>
 {%- set rows = [
   [{"w":"shot","p":["shot_ready","shot_run","shot_expired"]},{"w":"game","p":["clock_ready","clock_run","clock_last","clock_end","clock_ot"]},{"w":"score","p":["score","home","guest","score_rise"]}],
   [{"w":"cc","p":["cc1","cc3","cc2","cc_big"]}],
   [{"w":"tb","p":["tb_timer","tb_bar","tb_digits"]}] ] %}
 {% for b in t.roles.boxes %}{% set bi = loop.index0 %}
 <div class="rolebox card"><h3>{{ b.t }}</h3><p>{{ b.d }}</p>
  <table class="rl"><thead><tr>{% for h in t.roles.th %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>
  {% for r in b.rows %}{% set m = rows[bi][loop.index0] %}<tr><td><b>{{ r.t }}</b><span>{{ r.d }}</span></td><td class="ui">{{ phone(m.w, r.t) }}</td><td><div class="sx w">{% for p in m.p %}{{ pnl(p, "") }}{% endfor %}</div></td></tr>{% endfor %}
  </tbody></table></div>{% endfor %}
</div></section>

<section id="bedienung" class="alt"><div class="wrap">
 <div class="split"><div><div class="eyebrow">{{ t.operate.eyebrow }}</div><h2>{{ t.operate.title }}</h2><p class="sub">{{ t.operate.sub }}</p>
  <ul class="tick">{% for i in t.operate.ticks %}<li>{{ i }}</li>{% endfor %}</ul></div>
  <div class="ph3"><div class="phone"><img src="../assets/phone/pair.png" alt="" width="585" height="1266" loading="lazy"></div><div class="phone"><img src="../assets/phone/roles.png" alt="" width="585" height="1266" loading="lazy"></div><div class="phone"><img src="../assets/phone/score.png" alt="" width="585" height="1266" loading="lazy"></div></div></div>
</div></section>

<section id="hardware"><div class="wrap">
 <div class="split"><div><div class="eyebrow">{{ t.hardware.eyebrow }}</div><h2>{{ t.hardware.title }}</h2><p class="sub">{{ t.hardware.sub }}</p>
  <ul class="tick">{% for i in t.hardware.ticks %}<li>{{ i }}</li>{% endfor %}</ul><a class="btn s" href="hardware/">{{ t.hardware.more }}</a></div>
  <div class="photo"><img src="../assets/photos/stacked.jpg" alt="{{ t.hardware.alt }}" width="1200" height="900" loading="lazy"></div></div></div></section>

<section id="offen" class="alt"><div class="wrap">
 <div class="eyebrow">{{ t.open.eyebrow }}</div><h2>{{ t.open.title }}</h2>
 {%- set links = ["https://smengerl.github.io/gamiq-releases/" + L.lang + "/", "https://github.com/Smengerl/gamiq-releases/releases", "open/"] %}
 <div class="grid">{% for c in t.open.cards %}<div class="card"><b>{{ c.t }}</b><p>{{ c.d }}</p><p style="margin-top:12px"><a href="{{ links[loop.index0] }}">{{ c.l }}</a></p></div>{% endfor %}</div></div></section>

<section id="kontakt"><div class="wrap contact">
 <div><div class="eyebrow">{{ t.contact.eyebrow }}</div><h2>{{ t.contact.title }}</h2><p class="sub">{{ t.contact.sub }}</p>
  <ul class="tick">{% for i in t.contact.ticks %}<li>{{ i }}</li>{% endfor %}</ul></div>
 <form class="bub pad" id="cf" data-to="{{ t.contact.address }}" data-subject="{{ t.contact.subject }}">
  <label for="f1">{{ t.contact.f_club }}</label><input id="f1" name="club"><label for="f2">{{ t.contact.f_fields }}</label><input id="f2" name="fields">
  <label for="f3">{{ t.contact.f_wish }}</label><textarea id="f3" name="wish"></textarea>
  <p style="margin:var(--sp-4) 0 0"><button class="btn p" type="submit">{{ t.contact.btn }}</button></p></form>
</div></section>
<script>
// The mail is prepared in the visitor's own mail program: nothing is sent to or stored by this site.
document.getElementById("cf").addEventListener("submit", function (e) {
  e.preventDefault();
  var f = e.target, to = f.dataset.to;
  if (to === "TBD") return;
  var body = f.club.value + "\n" + f.fields.value + "\n\n" + f.wish.value;
  location.href = "mailto:" + to + "?subject=" + encodeURIComponent(f.dataset.subject) + "&body=" + encodeURIComponent(body);
});
</script>
