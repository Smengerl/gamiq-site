<header class="pghead"><div class="wrap split"><div><div class="eyebrow">{{ pg.eyebrow }}</div><h1 style="font-size:var(--fs-36)">{{ pg.title }}</h1><p class="lead">{{ pg.sub }}</p></div>
<div class="photo"><img src="../../assets/photos/stacked.jpg" alt="{{ pg.alt }}" width="1200" height="800"></div></div></header>
<section><div class="wrap"><h2>{{ pg.facts_title }}</h2><div class="grid">{% for i in pg.facts %}<div class="card"><b>{{ i.t }}</b><p>{{ i.d }}</p></div>{% endfor %}</div></div></section>
<section class="alt"><div class="wrap"><h2>{{ pg.open_title }}</h2><p class="sub">{{ pg.open_text }}</p><a class="btn s" href="../#downloads">{{ pg.open_btn }}</a></div></section>
